# ──────────────────────────────────────────────────────────────
# onetake-seo-ai — Express HTTP service for Azure Container Apps
#
# Mirrors the onetake-worker conventions:
#   - linux/amd64 (ACA) + linux/arm64 (local) buildx
#   - non-root user, tini for signal handling
#   - HEALTHCHECK that hits /health
#
# Build:
#   docker buildx build --platform linux/amd64 \
#     -f Dockerfile.aca -t novacert.azurecr.io/onetake-seo-ai:latest \
#     --push .
#
# Run locally:
#   docker run --env-file .env -p 3000:3000 \
#     novacert.azurecr.io/onetake-seo-ai:latest
# ──────────────────────────────────────────────────────────────

# ── Stage 1: deps ────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
RUN apk add --no-cache tini
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev

# ── Stage 2: runtime ─────────────────────────────────────────
FROM node:20-alpine AS runtime

ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0

WORKDIR /app

# tini for proper PID 1 signal handling in containerised environments
RUN apk add --no-cache tini

# Non-root user (matches onetake-worker pattern)
RUN addgroup -g 10001 -S app \
  && adduser -u 10001 -S app -G app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json* ./
COPY src/ ./src/

USER app

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -q -O - http://127.0.0.1:3000/health || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "src/index.js"]
